# Everything is optional. With nothing set the API uses the offline hashing embedder
# and rule-based suggestions.

# LLM for suggestions
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Embeddings for scoring (uses OPENAI_API_KEY / OPENAI_BASE_URL)
EMBEDDING_MODEL=
# Cosine similarity mapped to 0 and to 1. Tune per embedding model.
# EMBEDDING_CALIBRATION=0.20,0.60

CORS_ORIGINS=http://localhost:5173
